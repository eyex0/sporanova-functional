NODE_ENV=development
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Supabase Postgres (Transaction pooler)
DATABASE_URL=

# Session
SESSION_SECRET=
SESSION_DAYS=14

# Supabase API (for client-side / future use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=openai/gpt-4o
AI_BASE_URL=https://openrouter.ai/api/v1

# Email (Resend)
EMAIL_PROVIDER=console
EMAIL_FROM=SOPRANOVA <noreply@sopranova.com>
EMAIL_API_KEY=

# OAuth (Google)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Storage (S3-compatible; Supabase Storage works)
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Data encryption (64-char hex)
DATA_ENCRYPTION_KEY=

# Built-in Forge (legacy, not used)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
